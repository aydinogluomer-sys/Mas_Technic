{
  "$schema": "Mas Technic Design Tokens — kaynak: src/index.css + tailwind.config.ts + src/styles/z-index.ts",
  "$updated": "2026-05-12",

  "color": {
    "forge": {
      "obsidian":  { "hex": "#353c46", "hsl": "215 10% 24%",  "role": "dark background" },
      "gunmetal":  { "hex": "#424d5e", "hsl": "220 12% 30%",  "role": "medium dark panel" },
      "iron":      { "hex": "#384050", "hsl": "215 18% 27%",  "role": "section dark bg" },
      "molten":    { "hex": "#e8610a", "hsl": "23 92% 47%",   "role": "CTA / primary accent" },
      "amber":     { "hex": "#d4850e", "hsl": "37 88% 44%",   "role": "secondary accent" },
      "ember":     { "hex": "#b33030", "hsl": "0 58% 45%",    "role": "error / danger" },
      "teal":      { "hex": "#0a7e8c", "hsl": "186 87% 29%",  "role": "primary / interactive" },
      "silver":    { "hex": "#a8b2bc", "hsl": "210 14% 70%",  "role": "light gray / muted" },
      "steel":     { "hex": "#3a4a5c", "hsl": "212 22% 29%",  "role": "accent / brushed steel" },
      "concrete":  { "hex": "#e8e4de", "hsl": "36 22% 89%",   "role": "light background" },
      "workshop":  { "hex": "#f0ede8", "hsl": "38 25% 92%",   "role": "lightest background" },
      "mist":      { "hex": "#dde3e8", "hsl": "207 20% 89%",  "role": "light blue bg" }
    },
    "forge-heat": {
      "lava":      { "hex": "#ff6a00", "hsl": "24 100% 50%",  "role": "lava effect / hot orange" },
      "magma":     { "hex": "#e25822", "hsl": "14 73% 52%",   "role": "magma / red-orange" },
      "coal":      { "hex": "#b8451a", "hsl": "14 53% 41%",   "role": "coal / dark orange" }
    },
    "semantic": {
      "primary":   "hsl(186 87% 29%)",
      "accent":    "hsl(212 22% 29%)",
      "background": "hsl(0 0% 100%)",
      "foreground": "hsl(240 28% 14%)"
    },
    "dark-mode": {
      "background": "hsl(240 30% 8%)",
      "foreground": "hsl(36 22% 96%)",
      "primary":    "hsl(186 80% 35%)"
    },
    "neutral": {
      "50":  { "hex": "#EAEAEA" },
      "100": { "hex": "#CACACA" },
      "200": { "hex": "#A6A6A6" }
    },
    "accent-extended": {
      "blue":   { "hex": "#0061F4", "role": "accent blue" },
      "indigo": { "hex": "#5859F7", "role": "accent indigo" },
      "deep":   { "hex": "#2628DD", "role": "accent deep" },
      "abyss":  { "hex": "#0D0FAC", "role": "accent abyss" }
    }
  },

  "typography": {
    "fontFamily": {
      "sans": "Space Grotesk, system-ui, sans-serif",
      "mono": "IBM Plex Mono, monospace"
    },
    "scale": {
      "display-mega": { "size": "clamp(6rem, 18vw, 22rem)", "lineHeight": "0.82", "letterSpacing": "-0.06em", "weight": "700" },
      "h1":           { "size": "clamp(3.5rem, 8vw, 9rem)", "lineHeight": "0.92", "letterSpacing": "-0.04em" },
      "h2":           { "size": "clamp(2.5rem, 5.5vw, 6rem)", "lineHeight": "1.0", "letterSpacing": "-0.03em" },
      "h3":           { "size": "clamp(1.75rem, 3vw, 3rem)", "lineHeight": "1.05", "letterSpacing": "-0.02em" }
    }
  },

  "borderRadius": {
    "all": "0rem",
    "note": "Sharp industrial — radius yok, istisnasız"
  },

  "shadow": {
    "industrial":         "8px 8px 0px hsl(var(--forge-obsidian))",
    "industrial-primary": "8px 8px 0px hsl(var(--forge-teal) / 0.4)",
    "shadow-1": "0 1px 2px rgba(0, 0, 0, 0.04)",
    "shadow-2": "0 8px 24px -8px rgba(0, 0, 0, 0.12)",
    "shadow-3": "0 24px 60px -20px rgba(0, 0, 0, 0.25)",
    "shadow-1-dark": "0 1px 2px rgba(0, 0, 0, 0.30)",
    "shadow-2-dark": "0 8px 24px -8px rgba(0, 0, 0, 0.55)",
    "shadow-3-dark": "0 24px 60px -20px rgba(0, 0, 0, 0.75)"
  },

  "grid": {
    "columns": 8,
    "gap": "2rem",
    "maxWidth": "1400px",
    "container-padding": "2rem"
  },

  "zIndex": {
    "base": 0,
    "content": 1,
    "ambientGlow": 2,
    "grain": 5,
    "scrollVelocity": 8,
    "lavaTypography": 10,
    "moldCast": 11,
    "cncStory": 12,
    "marquee": 15,
    "dotNav": 20,
    "header": 50,
    "mobileMenu": 60,
    "cursor": 90,
    "pageTransition": 95,
    "preloader": 100,
    "note": "Kaynak: src/styles/z-index.ts — doğrudan değiştirilmez, Z objesi kullanılır"
  },

  "sectionStack": {
    "note": "SECTION_Z — her section öncekini örter (1-25 arası sıralı)",
    "hero": 1, "lavaTypography": 2, "moldCast": 3, "cncStory": 4,
    "services": 14, "industries": 15, "projectShowcase": 17,
    "materials": 19, "capabilities": 21, "testimonials": 22,
    "faqBlog": 23, "finalCta": 25
  }
}
