 MAS Technic hakkında: Hassas CNC imalat, prototipten seri üretime, havacılık-savunma-otomotiv-medikal sektörlerine hizmet veriyor.`;
 
+/* The site's routed languages (src/i18n/locale.ts LOCALE_TABLE). The client
+   sends `locale` with every request; anything else, or no value at all (an
+   older client), keeps the Turkish answer this function always gave. */
+const LOCALES: Record<string, { language: string; prefix: string }> = {
+  tr: { language: "Türkçe yanıt ver.", prefix: "" },
+  en: { language: "Yanıtı İngilizce (English) ver.", prefix: "/en" },
+  de: { language: "Yanıtı Almanca (Deutsch) ver.", prefix: "/de" },
+  ru: { language: "Yanıtı Rusça (русский) ver.", prefix: "/ru" },
+  zh: { language: "Yanıtı Basitleştirilmiş Çince (简体中文) ver.", prefix: "/zh" },
+};
+
+function systemPrompt(locale: unknown): string {
+  const entry = typeof locale === "string" && Object.hasOwn(LOCALES, locale) ? LOCALES[locale] : LOCALES.tr;
+  return SYSTEM_PROMPT.replace("{{LANGUAGE}}", entry.language).replace("{{RFQ_PATH}}", `${entry.prefix}/teklif-al`);
+}
