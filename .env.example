# .env.example — Mas Technic / Precision Dynamics Hub
# Bu dosya gerçek değerler içermez. .env veya .env.local dosyasına kopyala.
# Gerçek değerleri Supabase dashboard'dan al.

# ─── Supabase (Zorunlu) ──────────────────────────────────────────────────────

# Supabase project URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anon/public key (client-side güvenli)
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase project ID (Lovable entegrasyonu için)
VITE_SUPABASE_PROJECT_ID=your-project-id

# ─── Supabase Edge Functions (Sunucu tarafı — .env.local'da tut) ─────────────

# Google Gemini API key — chat ve finance-ai Edge Function için
# VITE_ prefix'i YOK — client'a expose edilmez
# GOOGLE_GEMINI_API_KEY=AIza...

# Supabase service role key — sadece Edge Functions içinde kullanılır
# ASLA client'a expose etme
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# ─── Geliştirme Ayarları (Opsiyonel) ─────────────────────────────────────────

# Lenis'i development'ta devre dışı bırakmak için (performance profiling)
# VITE_DISABLE_LENIS=true

# ─── Notlar ──────────────────────────────────────────────────────────────────
# - .env dosyası git'e commit edilmez (.gitignore'da)
# - VITE_ prefix'i ile başlayan değişkenler client bundle'a gömülür
# - Gizli değerler (service role key, API key) asla VITE_ prefix'i almaz
# - Supabase anon key client'a açıktır — RLS ile güvenli kılınır
